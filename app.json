{
  "expo": {
    "name": "TeeTime Cloud",
    "slug": "teetime-cloud",
    "version": "2.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22c55e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mycompany.teetimecloud",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "TeeTime Cloud uses your location to find golf courses near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22c55e"
      },
      "package": "com.mycompany.teetimecloud",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "scheme": "teetimecloud",
    "plugins": [
      "expo-asset",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "rxsoft-analytics-llc"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TeeTime Cloud uses your location to find golf courses near you."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "79ff8e83-5220-4519-8166-55c0720ca3ee"
      }
    }
  }
}
