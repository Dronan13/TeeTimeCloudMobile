{
  "expo": {
    "name": "TeeTime Cloud",
    "slug": "teetime-cloud",
    "version": "2.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22c55e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mycompany.teetimecloud",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22c55e"
      },
      "package": "com.mycompany.teetimecloud"
    },
    "scheme": "teetimecloud",
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "79ff8e83-5220-4519-8166-55c0720ca3ee"
      }
    }
  }
}
